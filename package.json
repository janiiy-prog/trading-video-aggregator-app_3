{
  "name": "trading-video-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker:poll": "tsx src/worker/ingestion/channelPoller.ts",
    "dev:worker:classify": "tsx src/worker/classification/runClassify.ts",
    "dev:worker:digest": "tsx src/worker/notifications/runDigestCron.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed:fake": "tsx src/db/seedFakeData.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "start:worker:poll": "node dist/worker/ingestion/channelPoller.js",
    "start:worker:transcripts": "node dist/worker/transcripts/runTranscripts.js",
    "start:worker:classify": "node dist/worker/classification/runClassify.js",
    "start:worker:digest": "node dist/worker/notifications/runDigestCron.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "pg-boss": "^9.0.3",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/node": "^20.14.12"
  }
}
