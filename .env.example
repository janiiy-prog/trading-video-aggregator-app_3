# Postgres connection (Supabase/Neon/local)
DATABASE_URL=postgres://user:password@localhost:5432/trading_video_app

# YouTube Data API v3 key (console.cloud.google.com)
YOUTUBE_API_KEY=

# LLM classification (only used for ambiguous keyword-tiebreak cases)
ANTHROPIC_API_KEY=

# Email digests
RESEND_API_KEY=
DIGEST_FROM_EMAIL=alerts@yourdomain.com

# API server
PORT=3000
